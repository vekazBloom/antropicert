# Supabase Postgres connection string.
#
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# "Transaction pooler" (port 6543). Replace [YOUR-PASSWORD] with your database
# password, and keep sslmode=require.
#
# The transaction pooler is the right choice for Vercel: serverless functions
# open and drop connections constantly, which exhausts a direct connection.
#
# Copy this file to .env.local for local development. Never commit .env.local.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require"
